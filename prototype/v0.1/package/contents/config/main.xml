<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="positionMode" type="String"><default>right</default></entry>
    <entry name="autoReturnRight" type="Bool">
      <label>Volver automaticamente a la derecha al desmaximizar</label>
      <default>true</default>
    </entry>
    <entry name="autoHideMalvina" type="Bool">
      <label>Ocultar Malvina y mostrarla tras hover sostenido</label>
      <default>true</default>
    </entry>
    <entry name="showLauncherIsland" type="Bool">
      <label>Mostrar Malvina (isla 2)</label>
      <default>true</default>
    </entry>
    <entry name="autoCollapseSO" type="Bool">
      <label>Contraer SO después de seleccionar una ventana</label>
      <default>true</default>
    </entry>
    <entry name="autoCollapseTray" type="Bool">
      <label>Contraer bandeja después de usar un icono</label>
      <default>false</default>
    </entry>
    <!-- Sólo parámetros de visualización; el archivo del usuario no se edita. -->
    <entry name="soLogoMode" type="String"><default>default</default></entry>
    <entry name="soLogoPath" type="String"><default></default></entry>
    <entry name="taskActiveGlowEnabled" type="Bool"><default>true</default></entry>
    <entry name="taskActiveDoubleBorderEnabled" type="Bool"><default>false</default></entry>
    <entry name="taskDisplayMode" type="String"><default>icon</default></entry>
    <entry name="taskFrameShape" type="String"><default>rounded</default></entry>
    <entry name="taskFrameColor" type="String"><default>#ffffff</default></entry>
    <entry name="taskFrameOpacity" type="Double"><default>0.12</default></entry>
    <entry name="taskFrameWidth" type="Double"><default>1</default></entry>
    <entry name="soTextLabel" type="String"><default>SO</default></entry>
    <entry name="soTextColor" type="String"><default>#ffffff</default></entry>
    <entry name="soTextBackground" type="String"><default>#192536</default></entry>
    <entry name="soTextBackgroundOpacity" type="Double"><default>0.9</default></entry>
    <entry name="soTextFontFamily" type="String"><default>Sans Serif</default></entry>
    <entry name="soTextFontSize" type="Int"><default>13</default></entry>
    <entry name="soTextBold" type="Bool"><default>true</default></entry>
    <entry name="soTextBackgroundImage" type="String"><default></default></entry>
    <entry name="soLogoShape" type="String"><default>square</default></entry>
    <entry name="soLogoFitMode" type="String"><default>stretch</default></entry>
    <entry name="soLogoZoom" type="Double"><default>1.0</default></entry>
    <entry name="soLogoPanX" type="Double"><default>0.0</default></entry>
    <entry name="soLogoPanY" type="Double"><default>0.0</default></entry>
    <entry name="soLogoAnimate" type="Bool"><default>true</default></entry>
    <entry name="soClockFontFamily" type="String"><default>Sans Serif</default></entry>
    <entry name="soClockFontSize" type="Int"><default>11</default></entry>
    <entry name="soClockTextColor" type="String"><default>#ffffff</default></entry>
    <entry name="soLogoRotation" type="Double"><default>0</default></entry>
    <!-- Alto configurado por usuario, constante durante cada interacción. -->
    <entry name="panelHeight" type="Double"><default>48</default></entry>
    <entry name="soledadHeight" type="Double"><default>44</default></entry>
    <entry name="malvinaHeight" type="Double"><default>44</default></entry>
    <entry name="soledadRadius" type="Double"><default>22</default></entry>
    <entry name="malvinaRadius" type="Double"><default>22</default></entry>
    <entry name="soledadMinWidth" type="Double"><default>0</default></entry>
    <entry name="malvinaWidth" type="Double"><default>52</default></entry>
    <!-- Preajustes visuales; el usuario puede mantener el radio individual. -->
    <entry name="soledadShape" type="String"><default>leftRoundRightSquare</default></entry>
    <entry name="malvinaShape" type="String"><default>rounded</default></entry>
    <entry name="gripShape" type="String"><default>square</default></entry>
    <entry name="trayButtonShape" type="String"><default>rounded</default></entry>
    <entry name="soButtonFrameShape" type="String"><default>capsule</default></entry>
    <entry name="soButtonWidth" type="Double"><default>96</default></entry>
    <entry name="soledadColor" type="String"><default>#010111</default></entry>
    <entry name="malvinaColor" type="String"><default>#101e31</default></entry>
    <entry name="soledadGradientEnabled" type="Bool"><default>false</default></entry>
    <entry name="soledadGradientEnd" type="String"><default>#ee9852</default></entry>
    <entry name="soledadGradientDirection" type="String"><default>topBottom</default></entry>
    <entry name="soledadGradientSyncBreathing" type="Bool"><default>false</default></entry>
    <entry name="soledadGradientBreathingIntensity" type="Double"><default>0.6</default></entry>
    <entry name="malvinaGradientEnabled" type="Bool"><default>false</default></entry>
    <entry name="malvinaGradientEnd" type="String"><default>#445577</default></entry>
    <entry name="malvinaGradientDirection" type="String"><default>topBottom</default></entry>
    <entry name="backgroundColor" type="String"><default>#202333</default></entry>
    <entry name="soledadOpacity" type="Double"><default>0.5</default></entry>
    <entry name="malvinaOpacity" type="Double"><default>1.0</default></entry>
    <entry name="backgroundOpacity" type="Double"><default>0.5</default></entry>
    <entry name="showBackground" type="Bool"><default>false</default></entry>
    <!-- Botones de bandeja y agarre heredan color y alfa de Soledad, salvo opt-in. -->
    <entry name="trayButtonColorOverride" type="Bool"><default>false</default></entry>
    <entry name="trayButtonColor" type="String"><default>#010111</default></entry>
    <entry name="trayButtonOpacity" type="Double"><default>0.5</default></entry>
    <entry name="gripButtonColorOverride" type="Bool"><default>false</default></entry>
    <entry name="gripButtonColor" type="String"><default>#010111</default></entry>
    <entry name="gripButtonOpacity" type="Double"><default>0.5</default></entry>
    <!-- Contorno opcional: alerta visual sin ventanas por defecto. -->
    <entry name="soActivityStyle" type="String"><default>orbit</default></entry>
    <entry name="soActivityShowWhenEmpty" type="Bool"><default>true</default></entry>
    <entry name="soActivityShowWhenOpen" type="Bool"><default>false</default></entry>
    <entry name="soActivityColor" type="String"><default>#35d7ff</default></entry>
    <entry name="soActivityStroke" type="Double"><default>0.75</default></entry>
    <entry name="soActivityMotion" type="Bool"><default>true</default></entry>
    <entry name="soActivityOrbitSpeed" type="Double"><default>1.5</default></entry>
    <entry name="soActivityTrailPercent" type="Int"><default>75</default></entry>
    <entry name="soActivityTrailStyle" type="String"><default>dashed</default></entry>
    <entry name="soActivityGlowColor" type="String"><default>#ffab52</default></entry>
    <entry name="soActivityGlowIntensity" type="Double"><default>0.7</default></entry>
    <entry name="soActivityGlowSpread" type="Double"><default>5</default></entry>
    <entry name="soActivityPulseSpeed" type="Double"><default>0.6</default></entry>
    <entry name="soActivityPulseDepth" type="Double"><default>0.7</default></entry>
    <entry name="soActivityGlowGradient" type="Bool"><default>true</default></entry>
  </group>
</kcfg>
